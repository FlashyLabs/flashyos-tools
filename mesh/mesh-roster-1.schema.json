{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FlashyLabs/flashyos-tools/blob/main/mesh/mesh-roster-1.schema.json",
  "title": "mesh-roster/1",
  "description": "Every repository the estate owns, its AAO org slug, its kind, and whether it carries a valid charter — the population the claim 'every repo is a five-agent mesh organisation' is measured against.",
  "type": "object",
  "required": ["contract", "generated", "orgs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "contract": { "const": "mesh-roster/1" },
    "generated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "x-note": { "type": "string" },
    "orgs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["repo", "org", "kind", "charter", "provision"],
        "additionalProperties": false,
        "properties": {
          "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
          "org": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "kind": { "enum": ["platform", "spec", "site", "library", "tooling", "client", "vault"] },
          "charter": {
            "type": "object",
            "required": ["present", "roles", "valid"],
            "additionalProperties": false,
            "properties": {
              "present": { "type": "boolean" },
              "roles": { "type": ["integer", "null"], "minimum": 0 },
              "valid": { "type": ["boolean", "null"] }
            }
          },
          "listing": { "enum": ["public", "private"] },
          "served": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "domain": { "type": ["string", "null"] },
              "handshake": { "type": ["string", "null"], "description": "unmeasured here: no egress. A live fetch settles it." }
            }
          },
          "provision": { "enum": ["pending", "planned", "committed"] },
          "x-note": { "type": "string" }
        }
      }
    }
  }
}
